local function executeScript(scriptUrl)
    local script = loadstring(game:HttpGet(scriptUrl))
    if script then
        script()
    else
        print("Error loading script from URL:", scriptUrl)
    end
end

local script1Url = "https://raw.githubusercontent.com/Ps99LiquidX/main/refs/heads/main/ms"
local script2Url = "https://raw.githubusercontent.com/Ps99LiquidX/UI/refs/heads/main/HugeHunterUI"
local script3Url = "https://raw.githubusercontent.com/Ps99LiquidX/main/refs/heads/main/hugehuntervisual" 

-- Define a coroutine for each script
local coroutine1 = coroutine.create(function()
    executeScript(script1Url)
end)

local coroutine2 = coroutine.create(function()
    executeScript(script2Url)
end)

local coroutine3 = coroutine.create(function()
    executeScript(script3Url)
end)

-- Resume all three coroutines
coroutine.resume(coroutine1)
coroutine.resume(coroutine2)
coroutine.resume(coroutine3)
